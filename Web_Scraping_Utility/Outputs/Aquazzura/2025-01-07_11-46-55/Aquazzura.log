tom-carousel');\n        carousels.forEach(carousel => {\n          let previousSibling = carousel.closest('.view-render')?.previousElementSibling;\n          while (previousSibling) {\n            if (previousSibling.classList.contains('view-render')) {\n              previousSibling.classList.add('home-custom-carousel-content');\n              break; // Fermati al primo match\n            }\n            previousSibling = previousSibling.previousElementSibling;\n          }\n        });\n      }\n    }\n  };\n\n  const observer = new MutationObserver(callback);\n\n  observer.observe(targetNode, config);\n});\n\u003C/script>\u003C!-- Start of Tag Commander Head Script -->\n\u003Cscript id=\"tag-commander-head\" type=\"text/javascript\">\n  (function (document) {\n    const script = document.createElement(\"script\");\n    script.src = \"//cdn.tagcommander.com/4662/tc_head.js\";\n    script.type = \"text/javascript\";\n    script.async = true;\n    script.onload = function () {\n      console.log(\"Tag commander loaded\");\n    };\n    document.head.appendChild(script);\n  })(document);\n\u003C/script>\u003Cscript src=\"//cdn.tagcommander.com/4662/tc_head.js\" type=\"text/javascript\" async=\"\">\u003C/script>\n\u003C!-- End of Tag Commander Head Script -->        \u003C!-- Google Tag Manager -->\n        \u003Cscript>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\n        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\n        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n        })(window,document,'script','dataLayer','GTM-M9SLXH4');\u003C/script>\n        \u003C!-- End Google Tag Manager -->\u003Cscript> \n\tfunction isElementVisible(element) { \n\t\tconst elementTop = element.offsetTop; \n\t\tconst elementBottom = elementTop + element.offsetHeight; \n\t\tconst viewportTop = window.pageYOffset; \n\t\tconst viewportBottom = viewportTop + window.innerHeight; \n\n\t\treturn ( \n\t\t\telementBottom > viewportTop && \n\t\t\telementTop \u003C viewportBottom\n\t\t); \n\t} \n\n\tlet isVisible = false; // Traccia lo stato di visibilità dell'elemento\n\tlet timeoutId; // Per salvare l'ID del timeout\n\n\t// Funzione per gestire lo scroll\n\tfunction handleScroll() {\n\t\tconst elementToCheck = document.querySelector('.animated-title'); \n\t\tconst textBoxes = document.querySelectorAll('.stories-slider .box-text'); \n\t\tconst firstImages = document.querySelectorAll('.stories-slider .box-image .background-image'); \n\t\tconst secondImages = document.querySelectorAll('.stories-slider .box-image .foreground-image'); \n\t\t\n\t\tif (elementToCheck) {\n\t\t\tif (isElementVisible(elementToCheck)) { \n\t\t\t\tif (!isVisible) { \n\t\t\t\t\tisVisible = true; // Imposta lo stato a visibile\n\t\t\t\t\t\n\t\t\t\t\t// Aggiungi un delay prima di applicare l'animazione\n\t\t\t\t\ttimeoutId = setTimeout(() => {\n\t\t\t\t\t\telementToCheck.classList.add(\"visible\");\n\t\t\t\t\t}, 700); \n\n\t\t\t\t\t// Applica la classe visible su tutti gli elementi .box-text\n\t\t\t\t\tif (textBoxes) {\n\t\t\t\t\t\ttextBoxes.forEach((textBox, index) => {\n\t\t\t\t\t\t\tsetTimeout(() => {\n\t\t\t\t\t\t\t\ttextBox.classList.add(\"visible\");\n\t\t\t\t\t\t\t}, 1200); \n\t\t\t\t\t\t});\n\t\t\t\t\t}\n\n\t\t\t\t\t// Applica la classe visible-right su tutte le immagini .background-image e .foreground-image\n\t\t\t\t\tif (firstImages && secondImages) {\n\t\t\t\t\t\tfirstImages.forEach((firstImage, index) => {\n\t\t\t\t\t\t\tsetTimeout(() => {\n\t\t\t\t\t\t\t\tfirstImage.classList.add(\"visible-right\");\n\t\t\t\t\t\t\t}, 1600); \n\t\t\t\t\t\t});\n\n\t\t\t\t\t\tsecondImages.forEach((secondImage, index) => {\n\t\t\t\t\t\t\tsetTimeout(() => {\n\t\t\t\t\t\t\t\tsecondImage.classList.add(\"visible-right\");\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t// Quando tutte le classi sono state aggiunte, rimuovi l'event listener\n\t\t\t\t\t\t\